{
  "name": "pumpfun-sniper-bot",
  "version": "1.0.0",
  "description": "Experimental Pump.fun sniper and wallet copy trading with paper trading, protected local dashboard and SQLite tracking",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start:ts": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "solana",
    "pump.fun",
    "sniper",
    "trading-bot",
    "indexer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "better-sqlite3": "^13.0.3",
    "bs58": "^6.0.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "jayson": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
