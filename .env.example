# Copie para .env no VSCode. Nunca publique .env, chaves ou backups.
# Simulação por padrão; iniciar uma estratégia exige comando explícito no painel.
DRY_RUN=true
AUTO_BUY=true
# Apenas para live experimental; não habilita operações automaticamente.
# A carteira dedicada deve estar configurada e apta a assinar.
LIVE_TRADING_ACK=

# RPC HTTP/WebSocket (não é um RPC auto-hospedado: o app é um cliente/indexador).
# Chave Helius opcional; RPC_URL tem preferência. WS_URL vazio é derivado do HTTP.
HELIUS_API_KEY=
RPC_URL=
WS_URL=
FALLBACK_RPC_URLS=https://api.mainnet-beta.solana.com
# processed observa execução antes de confirmação, com risco de fork.
# Copy Trade reconcilia os detalhes em confirmed antes de copiar.
DETECTION_COMMITMENT=confirmed
WS_HEARTBEAT_TIMEOUT_MS=30000

# Jupiter: configure SUA chave apenas neste arquivo local/secret do servidor.
# Nunca envie a chave no chat ou ao navegador. Sem rota = ignorar, sem DEX inventada.
JUPITER_API_KEY=

# Carteira dedicada criada no painel: arquivo cifrado, senha somente em memória.
WALLET_VAULT_PATH=./data/wallet.enc.json
WALLET_UNLOCK_TIMEOUT_MS=300000
# Compatibilidade com o PR #1: signer local dedicado via env; não recomendado.
# Não use seed/chave de carteira principal. Prefira a carteira cifrada do painel.
WALLET_PRIVATE_KEY=

# Compra e limites do Sniper (Copy Trade tem configurações próprias no painel).
BUY_AMOUNT_SOL=0.01
SLIPPAGE_PERCENT=5
ESTIMATED_FEE_PERCENT=1.5
PRIORITY_FEE_MICRO_LAMPORTS=100000
COMPUTE_UNIT_LIMIT=400000
SKIP_PREFLIGHT=false
TX_CONFIRM_TIMEOUT_MS=45000
MAX_OPEN_POSITIONS=3
# Reserva para taxas e aluguel; não é garantia de solvência.
MIN_WALLET_BALANCE_SOL=0.02
MAX_TOKEN_AGE_SECONDS=15
SKIP_MAYHEM_TOKENS=true
MAX_DEV_BUY_SOL=0
CLOSE_TOKEN_ACCOUNT_AFTER_SELL=true

# Saídas continuam sendo gerenciadas ao parar/trocar estratégia.
# Não há garantia de liquidez nem suporte a saída PumpSwap após migração.
TAKE_PROFIT_PERCENT=50
STOP_LOSS_PERCENT=10
TRAILING_STOP_PERCENT=0
MIN_GAIN_PERCENT=5
NO_GAIN_EXIT_SECONDS=20
MAX_HOLD_SECONDS=120
PRICE_CHECK_INTERVAL_MS=1500
SELL_RETRY_DELAY_MS=3000

# Recursos limitados para RPC de baixo custo; filas cheias ignoram observações.
TRACK_NEW_TOKENS_SECONDS=300
MAX_TRACKED_TOKENS=500
PRICE_TICK_INTERVAL_MS=2000
PRICE_TICK_RETENTION_HOURS=24
DATABASE_PATH=./data/pumpfun.db

# API local. Gere um segredo local: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem API_KEY, controles e carteira ficam indisponíveis.
# Não cole o segredo em localStorage. A chave do painel só fica em memória.
API_ENABLED=true
API_HOST=127.0.0.1
API_PORT=3000
API_KEY=
# Somente para proxy HTTPS confiável; listas exatas separadas por vírgula, sem *.
API_ALLOWED_HOSTS=
API_ALLOWED_ORIGINS=

# Alertas opcionais, nunca inclua chaves/senhas nas mensagens.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_ON_DETECTION=false
LOG_LEVEL=info
LOG_PRETTY=true
