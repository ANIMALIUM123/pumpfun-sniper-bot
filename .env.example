# =============================================================================
#  Pump.fun Sniper Bot – configuration
#  Copy to `.env` and adjust:   cp .env.example .env
#  Every variable is optional except WALLET_PRIVATE_KEY when DRY_RUN=false.
# =============================================================================

# ----------------------------------------------------------------------------
#  RPC (free tier is enough to start)
# ----------------------------------------------------------------------------
# Free Helius key: https://dashboard.helius.dev  (recommended – much better than public RPC)
HELIUS_API_KEY=
# Or any other RPC (overrides HELIUS_API_KEY). WS_URL is derived automatically if empty.
RPC_URL=
WS_URL=
# Comma-separated fallbacks used when the primary fails (default: Solana public RPC).
FALLBACK_RPC_URLS=https://api.mainnet-beta.solana.com
# processed = fastest detection, confirmed = fewer false positives
DETECTION_COMMITMENT=processed
# Resubscribe / fail over when the websocket is silent for this long (ms)
WS_HEARTBEAT_TIMEOUT_MS=30000

# ----------------------------------------------------------------------------
#  Wallet & mode
# ----------------------------------------------------------------------------
# true  = paper trading: simulated fills on real on-chain prices, no SOL spent (DEFAULT)
# false = LIVE trading with real SOL
DRY_RUN=true
# Base58 secret key (Phantom export), JSON array (solana-keygen) or path to a keypair file.
# ⚠️ Use a DEDICATED wallet holding only what you are willing to lose. Never commit this file.
WALLET_PRIVATE_KEY=
# false = only detect & record tokens (no buying). Can be toggled at runtime via the API.
AUTO_BUY=true

# ----------------------------------------------------------------------------
#  Buying
# ----------------------------------------------------------------------------
# SOL spent per token (Pump.fun fees included)
BUY_AMOUNT_SOL=0.01
# Max price movement tolerated between quote and execution (%)
SLIPPAGE_PERCENT=15
# Estimated Pump.fun protocol + creator fees, used for quotes and PnL (%)
ESTIMATED_FEE_PERCENT=1.5
# Priority fee (micro-lamports per compute unit) – higher = faster inclusion, more cost
PRIORITY_FEE_MICRO_LAMPORTS=100000
COMPUTE_UNIT_LIMIT=400000
SKIP_PREFLIGHT=true
TX_CONFIRM_TIMEOUT_MS=45000
MAX_OPEN_POSITIONS=3
# Stop buying when the wallet would drop below this balance (SOL)
MIN_WALLET_BALANCE_SOL=0.02
# Ignore tokens older than this when detected (s) – avoids buying late after reconnects
MAX_TOKEN_AGE_SECONDS=15
# Skip "mayhem mode" coins
SKIP_MAYHEM_TOKENS=true
# Skip tokens whose creator bought more than this at launch (SOL, 0 = disabled)
MAX_DEV_BUY_SOL=0
# Close the empty token account after selling to recover ~0.002 SOL rent
CLOSE_TOKEN_ACCOUNT_AFTER_SELL=true

# ----------------------------------------------------------------------------
#  Exit strategy – "buy at launch, ride the pump, exit fast if it doesn't move"
# ----------------------------------------------------------------------------
# Sell when profit reaches this (%)  e.g. 20, 50, 100
TAKE_PROFIT_PERCENT=50
# Sell when loss reaches this (%)    e.g. 5, 10
STOP_LOSS_PERCENT=10
# Optional trailing stop: after MIN_GAIN_PERCENT is reached, sell if value drops this % from the peak (0 = off)
TRAILING_STOP_PERCENT=0
# "No gain" threshold (%)
MIN_GAIN_PERCENT=5
# Sell if PnL is still below MIN_GAIN_PERCENT after this many seconds (0 = off)
NO_GAIN_EXIT_SECONDS=20
# Always sell after this many seconds
MAX_HOLD_SECONDS=120
# How often open positions are re-priced from the chain (ms) – also updated in real time from trades
PRICE_CHECK_INTERVAL_MS=1500
# Base delay before retrying a failed sell (ms, grows with each failure)
SELL_RETRY_DELAY_MS=3000

# ----------------------------------------------------------------------------
#  Indexer / price tracking
# ----------------------------------------------------------------------------
# Track the price of every new token for this long after launch (s, 0 = only positions)
TRACK_NEW_TOKENS_SECONDS=300
MAX_TRACKED_TOKENS=500
# Minimum interval between stored price points per token (ms)
PRICE_TICK_INTERVAL_MS=2000
# Delete price points older than this (hours)
PRICE_TICK_RETENTION_HOURS=24

# ----------------------------------------------------------------------------
#  Database
# ----------------------------------------------------------------------------
DATABASE_PATH=./data/pumpfun.db

# ----------------------------------------------------------------------------
#  REST API & dashboard  (http://127.0.0.1:3000)
# ----------------------------------------------------------------------------
API_ENABLED=true
# Keep 127.0.0.1 unless you need remote access (then set API_KEY and use HTTPS/reverse proxy)
API_HOST=127.0.0.1
API_PORT=3000
# When set, all /api requests must send it in the `x-api-key` header (a standard Authorization header also works).
# Control endpoints (sell / pause / resume) are only enabled when API_KEY is set.
API_KEY=

# ----------------------------------------------------------------------------
#  Alerts (optional)
# ----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=
# Create a bot with @BotFather, then get your chat id (e.g. via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Also alert on every detected token (very noisy)
ALERT_ON_DETECTION=false

# ----------------------------------------------------------------------------
#  Logging
# ----------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs (set false for JSON logs in production / log shippers)
LOG_PRETTY=true
